# Copie ce fichier en .env (ou configure ces variables sur ta plateforme
# d'hébergement) et remplis les valeurs. Ne commite jamais le vrai .env.

# Port d'écoute du serveur (Render le fournit automatiquement).
PORT=3001

# Origine autorisée pour les requêtes CORS. En production, mets l'URL exacte
# de ton site (ex: https://egs.netlify.app) au lieu de '*'.
ALLOWED_ORIGIN=*

# Clé requise (en-tête x-api-key) pour lire les listes complètes
# (inscriptions, abonnements, rendez-vous) et pour les suppressions.
# Choisis une chaîne longue et aléatoire, ex: openssl rand -hex 32
ADMIN_API_KEY=change-moi

# --- Envoi des alertes par e-mail (nodemailer / SMTP) ---
# Laisse SMTP_HOST vide pour un mode "dry-run" (les envois sont juste
# journalisés en console) — pratique en développement local.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=alertes@egs.example.com

# Nombre de jours avant de pouvoir renotifier la même ville (anti-spam).
ALERT_COOLDOWN_DAYS=3

# Planificateur interne (setInterval) — à activer seulement si le service
# tourne en continu (plan payant). Sur le plan gratuit, utilise plutôt le
# Render Cron Job défini dans render.yaml.
ENABLE_INTERNAL_SCHEDULER=false
SCHEDULER_INTERVAL_HOURS=6

# Utilisées uniquement par scripts/trigger-check.js (appelé par le cron) :
EGS_API_URL=https://ton-api.onrender.com
